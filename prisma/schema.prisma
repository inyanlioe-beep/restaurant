// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ──────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CHEF
  WAITER
  HOST
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  UPI
  MOBILE_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  WASTE
  RETURN
  TRANSFER
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ShiftStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ClockStatus {
  CLOCKED_IN
  ON_BREAK
  CLOCKED_OUT
}

// ── MODELS ─────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  role          UserRole  @default(STAFF)
  avatarUrl     String?
  isActive      Boolean   @default(true)
  emailVerified DateTime?
  resetToken    String?
  resetTokenExp DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  branchId       String?
  branch         Branch?           @relation(fields: [branchId], references: [id])
  staffShifts    StaffShift[]
  clockEntries   StaffClockEntry[]
  orders         Order[]           @relation("OrderTakenBy")
  servedOrders   OrderItem[]       @relation("ServedBy")
  payments       Payment[]
  invoices       Invoice[]         @relation("IssuedBy")
  purchaseOrders PurchaseOrder[]
  stockMovements StockMovement[]
  activityLogs   ActivityLog[]
  reservations   Reservation[]     @relation("ReservedBy")

  @@index([branchId])
  @@index([email])
  @@index([role])
}

model Branch {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String
  city      String
  state     String?
  zipCode   String?
  phone     String
  email     String?
  taxRate   Float    @default(0.0)
  currency  String   @default("USD")
  timezone  String   @default("UTC")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  floors         Floor[]
  menuCategories MenuCategory[]
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  reservations   Reservation[]
  invoices       Invoice[]
  activityLogs   ActivityLog[]
}

model Floor {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id])
  tables   Table[]

  @@unique([branchId, name])
  @@index([branchId])
}

model Table {
  id        String   @id @default(cuid())
  label     String // e.g., "T1", "A2"
  capacity  Int      @default(2)
  shape     String?  @default("rectangle") // rectangle, circle, square
  posX      Float    @default(0)
  posY      Float    @default(0)
  width     Float    @default(80)
  height    Float    @default(80)
  rotation  Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  floorId      String
  floor        Floor              @relation(fields: [floorId], references: [id])
  orders       Order[]
  reservations ReservationTable[]

  @@unique([floorId, label])
  @@index([floorId])
}

model MenuCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId String
  branch   Branch         @relation(fields: [branchId], references: [id])
  parentId String?
  parent   MenuCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children MenuCategory[] @relation("CategoryHierarchy")
  items    MenuItem[]

  @@unique([branchId, name])
  @@index([branchId])
}

model MenuItem {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  cost        Decimal? @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  isPopular   Boolean  @default(false)
  sortOrder   Int      @default(0)
  prepTime    Int? // minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId     String
  category       MenuCategory       @relation(fields: [categoryId], references: [id])
  modifiers      MenuItemModifier[]
  orderItems     OrderItem[]
  inventoryItems InventoryItem[]    @relation("InventoryMenuItems")

  @@index([categoryId])
  @@index([name])
}

model MenuItemModifier {
  id         String   @id @default(cuid())
  name       String // e.g., "Size", "Extra Cheese", "Side"
  type       String   @default("SELECT") // SELECT, MULTI, TEXT, QUANTITY
  isRequired Boolean  @default(false)
  minSelect  Int      @default(0)
  maxSelect  Int      @default(1)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  menuItemId         String
  menuItem           MenuItem            @relation(fields: [menuItemId], references: [id])
  options            ModifierOption[]
  orderItemModifiers OrderItemModifier[]

  @@index([menuItemId])
}

model ModifierOption {
  id          String   @id @default(cuid())
  label       String // e.g., "Large", "Extra Cheese"
  priceAdjust Decimal  @default(0.0) @db.Decimal(10, 2)
  isDefault   Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modifierId         String
  modifier           MenuItemModifier    @relation(fields: [modifierId], references: [id])
  orderItemModifiers OrderItemModifier[]

  @@index([modifierId])
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   Int         @unique @default(autoincrement())
  status        OrderStatus @default(PENDING)
  type          String      @default("DINE_IN") // DINE_IN, TAKEAWAY, DELIVERY
  note          String?
  subtotal      Decimal     @default(0.0) @db.Decimal(10, 2)
  taxAmount     Decimal     @default(0.0) @db.Decimal(10, 2)
  discount      Decimal     @default(0.0) @db.Decimal(10, 2)
  totalAmount   Decimal     @default(0.0) @db.Decimal(10, 2)
  customerCount Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  tableId       String?
  table         Table?       @relation(fields: [tableId], references: [id])
  takenById     String
  takenBy       User         @relation("OrderTakenBy", fields: [takenById], references: [id])
  items         OrderItem[]
  invoice       Invoice?
  reservationId String?      @unique
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  @@index([status])
  @@index([tableId])
  @@index([takenById])
  @@index([createdAt])
}

model OrderItem {
  id         String   @id @default(cuid())
  quantity   Int      @default(1)
  unitPrice  Decimal  @db.Decimal(10, 2)
  totalPrice Decimal  @db.Decimal(10, 2)
  note       String?
  status     String   @default("PENDING") // PENDING, PREPARING, READY, SERVED, CANCELLED
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderId    String
  order      Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem            @relation(fields: [menuItemId], references: [id])
  servedById String?
  servedBy   User?               @relation("ServedBy", fields: [servedById], references: [id])
  modifiers  OrderItemModifier[]

  @@index([orderId])
  @@index([status])
}

model OrderItemModifier {
  id          String  @id @default(cuid())
  quantity    Int     @default(1)
  priceAdjust Decimal @default(0.0) @db.Decimal(10, 2)

  orderItemId String
  orderItem   OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  modifierId  String
  modifier    MenuItemModifier @relation(fields: [modifierId], references: [id])
  optionId    String?
  option      ModifierOption?  @relation(fields: [optionId], references: [id])
  customValue String? // for TEXT type modifiers

  @@index([orderItemId])
}

model Reservation {
  id              String            @id @default(cuid())
  guestName       String
  guestPhone      String?
  guestEmail      String?
  guestCount      Int
  startTime       DateTime
  endTime         DateTime
  status          ReservationStatus @default(PENDING)
  note            String?
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  branchId     String
  branch       Branch             @relation(fields: [branchId], references: [id])
  reservedById String?
  reservedBy   User?              @relation("ReservedBy", fields: [reservedById], references: [id])
  tables       ReservationTable[]
  order        Order?

  @@index([branchId])
  @@index([startTime])
  @@index([status])
  @@index([guestPhone])
}

model ReservationTable {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  tableId       String
  table         Table       @relation(fields: [tableId], references: [id])

  @@unique([reservationId, tableId])
  @@index([tableId])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  subtotal      Decimal  @default(0.0) @db.Decimal(10, 2)
  taxAmount     Decimal  @default(0.0) @db.Decimal(10, 2)
  discount      Decimal  @default(0.0) @db.Decimal(10, 2)
  serviceCharge Decimal  @default(0.0) @db.Decimal(10, 2)
  totalAmount   Decimal  @default(0.0) @db.Decimal(10, 2)
  roundedAmount Decimal? @db.Decimal(10, 2)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branchId   String
  branch     Branch    @relation(fields: [branchId], references: [id])
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id])
  issuedById String
  issuedBy   User      @relation("IssuedBy", fields: [issuedById], references: [id])
  payments   Payment[]

  @@index([branchId])
  @@index([invoiceNumber])
  @@index([createdAt])
}

model Payment {
  id          String        @id @default(cuid())
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod @default(CASH)
  status      PaymentStatus @default(PAID)
  referenceNo String?
  tipAmount   Decimal       @default(0.0) @db.Decimal(10, 2)
  processedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoiceId     String
  invoice       Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  processedById String
  processedBy   User    @relation(fields: [processedById], references: [id])

  @@index([invoiceId])
  @@index([processedAt])
}

model InventoryItem {
  id          String   @id @default(cuid())
  name        String
  sku         String?
  category    String   @default("OTHER") // PRODUCE, MEAT, DAIRY, DRY_GOODS, BEVERAGE, OTHER
  unit        String   @default("UNIT") // KG, L, UNIT, BOX, PACK, etc.
  quantity    Decimal  @default(0.0) @db.Decimal(12, 4)
  minQuantity Decimal  @default(10.0) @db.Decimal(12, 4)
  maxQuantity Decimal? @db.Decimal(12, 4)
  costPerUnit Decimal? @db.Decimal(10, 4)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branchId           String
  branch             Branch              @relation(fields: [branchId], references: [id])
  menuItems          MenuItem[]          @relation("InventoryMenuItems")
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]

  @@unique([branchId, name])
  @@index([branchId])
  @@index([sku])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique
  supplier     String
  status       PurchaseOrderStatus @default(DRAFT)
  notes        String?
  expectedDate DateTime?
  totalAmount  Decimal             @default(0.0) @db.Decimal(12, 2)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  branchId    String
  branch      Branch              @relation(fields: [branchId], references: [id])
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  items       PurchaseOrderItem[]

  @@index([branchId])
  @@index([poNumber])
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  quantityOrdered  Decimal @db.Decimal(12, 4)
  quantityReceived Decimal @default(0.0) @db.Decimal(12, 4)
  unitCost         Decimal @db.Decimal(10, 4)
  totalCost        Decimal @db.Decimal(12, 2)

  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([purchaseOrderId])
}

model StockMovement {
  id        String                @id @default(cuid())
  type      InventoryMovementType
  quantity  Decimal               @db.Decimal(12, 4)
  reference String? // e.g., "Order #123", "PO-001", "Waste"
  notes     String?
  createdAt DateTime              @default(now())

  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  performedById   String
  performedBy     User          @relation(fields: [performedById], references: [id])

  @@index([inventoryItemId])
  @@index([createdAt])
  @@index([type])
}

model StaffShift {
  id        String      @id @default(cuid())
  date      DateTime    @db.Date
  startTime DateTime
  endTime   DateTime?
  role      String? // override role for this shift
  status    ShiftStatus @default(PLANNED)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

model StaffClockEntry {
  id         String      @id @default(cuid())
  clockIn    DateTime
  clockOut   DateTime?
  breakStart DateTime?
  breakEnd   DateTime?
  status     ClockStatus @default(CLOCKED_IN)
  note       String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([clockIn])
}

model ActivityLog {
  id        String   @id @default(cuid())
  action    String // e.g., "ORDER_CREATED", "PAYMENT_RECEIVED", "MENU_UPDATED"
  entity    String // "ORDER", "MENU_ITEM", "TABLE", etc.
  entityId  String?
  details   Json? // Flexible payload
  createdAt DateTime @default(now())

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])
  userId   String?
  user     User?   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}
